{
  "name": "git-pro",
  "displayName": "Git Pro",
  "description": "%extension.description%",
  "version": "0.2.2",
  "publisher": "longtd",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nhech/git-pro.git"
  },
  "bugs": {
    "url": "https://github.com/nhech/git-pro/issues"
  },
  "homepage": "https://git-pro.longtd.me/",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "source control",
    "commit",
    "stage",
    "history",
    "graph",
    "blame",
    "rebase",
    "stash",
    "worktree",
    "merge",
    "conflict",
    "merge conflicts",
    "compare",
    "diff",
    "branch",
    "cherry-pick",
    "scm"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitPro.refresh",
        "title": "%command.gitPro.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPro.selectRepository",
        "title": "%command.gitPro.selectRepository.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.openFile",
        "title": "%command.gitPro.openFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.showOutput",
        "title": "%command.gitPro.showOutput.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.stage",
        "title": "%command.gitPro.stage.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "gitPro.unstage",
        "title": "%command.gitPro.unstage.title%",
        "category": "%command.category%",
        "icon": "$(remove)"
      },
      {
        "command": "gitPro.stageFolder",
        "title": "%command.gitPro.stageFolder.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "gitPro.unstageFolder",
        "title": "%command.gitPro.unstageFolder.title%",
        "category": "%command.category%",
        "icon": "$(remove)"
      },
      {
        "command": "gitPro.discardFolder",
        "title": "%command.gitPro.discardFolder.title%",
        "category": "%command.category%",
        "icon": "$(discard)"
      },
      {
        "command": "gitPro.stageAll",
        "title": "%command.gitPro.stageAll.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "gitPro.unstageAll",
        "title": "%command.gitPro.unstageAll.title%",
        "category": "%command.category%",
        "icon": "$(remove)"
      },
      {
        "command": "gitPro.diff",
        "title": "%command.gitPro.diff.title%",
        "category": "%command.category%",
        "icon": "$(diff)"
      },
      {
        "command": "gitPro.diffHead",
        "title": "%command.gitPro.diffHead.title%",
        "category": "%command.category%",
        "icon": "$(diff)"
      },
      {
        "command": "gitPro.discard",
        "title": "%command.gitPro.discard.title%",
        "category": "%command.category%",
        "icon": "$(discard)"
      },
      {
        "command": "gitPro.commit",
        "title": "%command.gitPro.commit.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "gitPro.fetch",
        "title": "%command.gitPro.fetch.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitPro.pull",
        "title": "%command.gitPro.pull.title%",
        "category": "%command.category%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitPro.push",
        "title": "%command.gitPro.push.title%",
        "category": "%command.category%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitPro.branches",
        "title": "%command.gitPro.branches.title%",
        "category": "%command.category%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitPro.branchActions",
        "title": "%command.gitPro.branchActions.title%",
        "category": "%command.category%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitPro.createBranch",
        "title": "%command.gitPro.createBranch.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "gitPro.copyPath",
        "title": "%command.gitPro.copyPath.title%",
        "category": "%command.category%",
        "icon": "$(copy)"
      },
      {
        "command": "gitPro.init",
        "title": "%command.gitPro.init.title%",
        "category": "%command.category%",
        "icon": "$(repo-create)"
      },
      {
        "command": "gitPro.clone",
        "title": "%command.gitPro.clone.title%",
        "category": "%command.category%",
        "icon": "$(repo-clone)"
      },
      {
        "command": "gitPro.history",
        "title": "%command.gitPro.history.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "gitPro.historyRefs",
        "title": "%command.gitPro.historyRefs.title%",
        "category": "%command.category%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitPro.fileHistory",
        "title": "%command.gitPro.fileHistory.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "gitPro.toggleBlame",
        "title": "%command.gitPro.toggleBlame.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.advancedActions",
        "title": "%command.gitPro.advancedActions.title%",
        "category": "%command.category%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitPro.resolveConflict",
        "title": "%command.gitPro.resolveConflict.title%",
        "category": "%command.category%",
        "icon": "$(warning)"
      },
      {
        "command": "gitPro.forcePushWithLease",
        "title": "%command.gitPro.forcePushWithLease.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.interactiveRebase",
        "title": "%command.gitPro.interactiveRebase.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.repositoryTools",
        "title": "%command.gitPro.repositoryTools.title%",
        "category": "%command.category%",
        "icon": "$(tools)"
      },
      {
        "command": "gitPro.hunkActions",
        "title": "%command.gitPro.hunkActions.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.commitFile",
        "title": "%command.gitPro.commitFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.openBlameCommit",
        "title": "%command.gitPro.openBlameCommit.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.conflicts.open",
        "title": "%command.gitPro.conflicts.open.title%",
        "category": "%command.category%",
        "icon": "$(warning)"
      },
      {
        "command": "gitPro.conflicts.acceptYours",
        "title": "%command.gitPro.conflicts.acceptYours.title%",
        "category": "%command.category%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitPro.conflicts.acceptTheirs",
        "title": "%command.gitPro.conflicts.acceptTheirs.title%",
        "category": "%command.category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitPro.conflicts.merge",
        "title": "%command.gitPro.conflicts.merge.title%",
        "category": "%command.category%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitPro.mergeEditor.apply",
        "title": "%command.gitPro.mergeEditor.apply.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "gitPro.mergeEditor.nextFile",
        "title": "%command.gitPro.mergeEditor.nextFile.title%",
        "category": "%command.category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitPro.mergeEditor.back",
        "title": "%command.gitPro.mergeEditor.back.title%",
        "category": "%command.category%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "gitPro.operation.menu",
        "title": "%command.gitPro.operation.menu.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.operation.continue",
        "title": "%command.gitPro.operation.continue.title%",
        "category": "%command.category%",
        "icon": "$(debug-continue)"
      },
      {
        "command": "gitPro.operation.abort",
        "title": "%command.gitPro.operation.abort.title%",
        "category": "%command.category%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "gitPro.operation.skip",
        "title": "%command.gitPro.operation.skip.title%",
        "category": "%command.category%",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "gitPro.compareWithCurrent",
        "title": "%command.gitPro.compareWithCurrent.title%",
        "category": "%command.category%",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitPro.diffWithWorkingTree",
        "title": "%command.gitPro.diffWithWorkingTree.title%",
        "category": "%command.category%",
        "icon": "$(diff)"
      },
      {
        "command": "gitPro.compareBranches",
        "title": "%command.gitPro.compareBranches.title%",
        "category": "%command.category%",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitPro.compareWithBranch",
        "title": "%command.gitPro.compareWithBranch.title%",
        "category": "%command.category%"
      },
      {
        "command": "gitPro.compareWithRef",
        "title": "%command.gitPro.compareWithRef.title%",
        "category": "%command.category%",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitPro.mergeIntoCurrent",
        "title": "%command.gitPro.mergeIntoCurrent.title%",
        "category": "%command.category%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitPro.rebaseCurrentOnto",
        "title": "%command.gitPro.rebaseCurrentOnto.title%",
        "category": "%command.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitPro",
          "title": "%container.gitPro.title%",
          "icon": "media/git-pro.svg"
        }
      ]
    },
    "views": {
      "gitPro": [
        {
          "id": "gitPro.repositories",
          "name": "%view.gitPro.repositories.name%",
          "visibility": "collapsed"
        },
        {
          "id": "gitPro.commitView",
          "name": "%view.gitPro.commitView.name%",
          "type": "webview",
          "initialSize": 120
        },
        {
          "id": "gitPro.changes",
          "name": "%view.gitPro.changes.name%",
          "type": "webview",
          "initialSize": 700
        },
        {
          "id": "gitPro.branchesView",
          "name": "%view.gitPro.branchesView.name%",
          "visibility": "collapsed"
        },
        {
          "id": "gitPro.toolsView",
          "name": "%view.gitPro.toolsView.name%",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitPro.repositories",
        "contents": "%viewsWelcome.repositories.contents%",
        "when": "!gitPro.hasRepositories"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitPro.refresh",
          "when": "view == gitPro.repositories || view == gitPro.changes",
          "group": "navigation"
        },
        {
          "command": "gitPro.stageAll",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.unstageAll",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.commit",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.fetch",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.pull",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.push",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.branches",
          "when": "view == gitPro.branchesView",
          "group": "navigation@1"
        },
        {
          "command": "gitPro.fetch",
          "when": "view == gitPro.branchesView && gitPro.hasRepositories",
          "group": "navigation@2"
        },
        {
          "command": "gitPro.refresh",
          "when": "view == gitPro.branchesView && gitPro.hasRepositories",
          "group": "navigation@3"
        },
        {
          "command": "gitPro.history",
          "when": "view == gitPro.repositories && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.historyRefs",
          "when": "view == gitPro.repositories && gitPro.hasRepositories",
          "group": "history"
        },
        {
          "command": "gitPro.conflicts.open",
          "when": "view == gitPro.changes && gitPro.hasConflicts",
          "group": "navigation"
        },
        {
          "command": "gitPro.advancedActions",
          "when": "view == gitPro.changes && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.repositoryTools",
          "when": "view == gitPro.repositories && gitPro.hasRepositories",
          "group": "navigation"
        },
        {
          "command": "gitPro.repositoryTools",
          "when": "view == gitPro.toolsView && gitPro.hasRepositories",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitPro.branchActions",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\./",
          "group": "inline"
        },
        {
          "command": "gitPro.branchActions",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\./",
          "group": "gitPro"
        },
        {
          "command": "gitPro.compareWithCurrent",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\.(local|remote)$/ && !listMultiSelection",
          "group": "compare@1"
        },
        {
          "command": "gitPro.diffWithWorkingTree",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\.(local|remote)$/ && !listMultiSelection",
          "group": "compare@2"
        },
        {
          "command": "gitPro.compareBranches",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\./ && listDoubleSelection",
          "group": "compare@3"
        },
        {
          "command": "gitPro.compareWithBranch",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\./ && !listMultiSelection",
          "group": "compare@4"
        },
        {
          "command": "gitPro.mergeIntoCurrent",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\.(local|remote)$/ && !listMultiSelection",
          "group": "integrate@1"
        },
        {
          "command": "gitPro.rebaseCurrentOnto",
          "when": "view == gitPro.branchesView && viewItem =~ /^gitPro\\.branch\\.(local|remote)$/ && !listMultiSelection",
          "group": "integrate@2"
        },
        {
          "command": "gitPro.repositoryTools",
          "when": "view == gitPro.toolsView && viewItem == gitPro.tools",
          "group": "gitPro"
        }
      ],
      "editor/context": [
        {
          "command": "gitPro.fileHistory",
          "when": "resourceScheme == file && gitPro.hasRepositories",
          "group": "gitPro"
        }
      ],
      "editor/title": [
        {
          "command": "gitPro.mergeEditor.apply",
          "when": "isMergeEditor && mergeEditorResultUri in gitPro.conflictResources",
          "group": "navigation@1"
        },
        {
          "command": "gitPro.mergeEditor.nextFile",
          "when": "isMergeEditor && mergeEditorResultUri in gitPro.conflictResources",
          "group": "navigation@2"
        },
        {
          "command": "gitPro.mergeEditor.back",
          "when": "isMergeEditor && mergeEditorResultUri in gitPro.conflictResources",
          "group": "navigation@3"
        },
        {
          "command": "gitPro.conflicts.merge",
          "when": "resourceScheme == file && resource in gitPro.conflictResources && !isMergeEditor",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitPro.compareWithRef",
          "when": "resourceScheme == file && gitPro.hasRepositories",
          "group": "3_compare"
        }
      ],
      "explorer/context": [
        {
          "command": "gitPro.compareWithRef",
          "when": "resourceScheme == file && gitPro.hasRepositories && !explorerResourceIsFolder",
          "group": "3_compare"
        }
      ],
      "commandPalette": [
        {
          "command": "gitPro.openFile",
          "when": "false"
        },
        {
          "command": "gitPro.stageFolder",
          "when": "false"
        },
        {
          "command": "gitPro.unstageFolder",
          "when": "false"
        },
        {
          "command": "gitPro.discardFolder",
          "when": "false"
        },
        {
          "command": "gitPro.conflicts.acceptYours",
          "when": "false"
        },
        {
          "command": "gitPro.conflicts.acceptTheirs",
          "when": "false"
        },
        {
          "command": "gitPro.conflicts.merge",
          "when": "false"
        },
        {
          "command": "gitPro.compareBranches",
          "when": "false"
        },
        {
          "command": "gitPro.mergeIntoCurrent",
          "when": "false"
        },
        {
          "command": "gitPro.rebaseCurrentOnto",
          "when": "false"
        },
        {
          "command": "gitPro.mergeEditor.apply",
          "when": "isMergeEditor && mergeEditorResultUri in gitPro.conflictResources"
        },
        {
          "command": "gitPro.mergeEditor.nextFile",
          "when": "gitPro.hasConflicts"
        },
        {
          "command": "gitPro.mergeEditor.back",
          "when": "gitPro.hasConflicts"
        },
        {
          "command": "gitPro.operation.continue",
          "when": "gitPro.operation =~ /^(merging|rebasing|cherry-picking|reverting)$/"
        },
        {
          "command": "gitPro.operation.abort",
          "when": "gitPro.operation =~ /^(merging|rebasing|cherry-picking|reverting)$/"
        },
        {
          "command": "gitPro.operation.skip",
          "when": "gitPro.operation =~ /^(rebasing|cherry-picking|reverting)$/"
        }
      ]
    },
    "colors": [
      {
        "id": "gitPro.accent",
        "description": "%color.gitPro.accent.description%",
        "defaults": {
          "dark": "#f2542d",
          "light": "#c2410c",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      }
    ],
    "configuration": {
      "title": "Git Pro",
      "properties": {
        "gitPro.logging.level": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "scope": "window",
          "description": "%setting.gitPro.logging.level.description%"
        },
        "gitPro.commit.confirmBeforeCommit": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.commit.confirmBeforeCommit.description%"
        },
        "gitPro.confirmBeforePush": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.confirmBeforePush.description%"
        },
        "gitPro.pull.strategy": {
          "type": "string",
          "enum": [
            "ff-only",
            "merge",
            "rebase"
          ],
          "default": "ff-only",
          "scope": "resource",
          "description": "%setting.gitPro.pull.strategy.description%"
        },
        "gitPro.commit.subjectLimit": {
          "type": "integer",
          "default": 72,
          "minimum": 20,
          "maximum": 200,
          "scope": "resource",
          "description": "%setting.gitPro.commit.subjectLimit.description%"
        },
        "gitPro.commit.messageHistoryLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "scope": "resource",
          "description": "%setting.gitPro.commit.messageHistoryLimit.description%"
        },
        "gitPro.autoFetch.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.autoFetch.enabled.description%"
        },
        "gitPro.autoFetch.intervalMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "scope": "resource",
          "description": "%setting.gitPro.autoFetch.intervalMinutes.description%"
        },
        "gitPro.blame.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.blame.enabled.description%"
        },
        "gitPro.codeLens.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.codeLens.enabled.description%"
        },
        "gitPro.blame.delay": {
          "type": "integer",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "scope": "resource",
          "description": "%setting.gitPro.blame.delay.description%"
        },
        "gitPro.graph.pageSize": {
          "type": "integer",
          "default": 100,
          "minimum": 25,
          "maximum": 100,
          "scope": "resource",
          "description": "%setting.gitPro.graph.pageSize.description%"
        },
        "gitPro.graph.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%setting.gitPro.graph.showRemoteBranches.description%"
        },
        "gitPro.changes.groupBy": {
          "type": "string",
          "enum": [
            "status",
            "folder"
          ],
          "default": "status",
          "scope": "resource",
          "description": "%setting.gitPro.changes.groupBy.description%"
        },
        "gitPro.conflicts.autoOpen": {
          "type": "string",
          "enum": [
            "gitPro",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%setting.gitPro.conflicts.autoOpen.gitPro%",
            "%setting.gitPro.conflicts.autoOpen.always%",
            "%setting.gitPro.conflicts.autoOpen.never%"
          ],
          "default": "gitPro",
          "scope": "resource",
          "description": "%setting.gitPro.conflicts.autoOpen.description%"
        },
        "gitPro.conflicts.groupByDirectory": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%setting.gitPro.conflicts.groupByDirectory.description%"
        },
        "gitPro.compare.defaultFilesMode": {
          "type": "string",
          "enum": [
            "fork",
            "tips"
          ],
          "enumDescriptions": [
            "%setting.gitPro.compare.defaultFilesMode.fork%",
            "%setting.gitPro.compare.defaultFilesMode.tips%"
          ],
          "default": "fork",
          "scope": "resource",
          "description": "%setting.gitPro.compare.defaultFilesMode.description%"
        },
        "gitPro.cli.readTimeout": {
          "type": "integer",
          "default": 15,
          "minimum": 5,
          "maximum": 600,
          "scope": "machine",
          "description": "%setting.gitPro.cli.readTimeout.description%"
        },
        "gitPro.cli.timeout": {
          "type": "integer",
          "default": 120,
          "minimum": 15,
          "maximum": 600,
          "scope": "machine",
          "description": "%setting.gitPro.cli.timeout.description%"
        },
        "gitPro.cli.networkTimeout": {
          "type": "integer",
          "default": 180,
          "minimum": 30,
          "maximum": 900,
          "scope": "machine",
          "description": "%setting.gitPro.cli.networkTimeout.description%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts media esbuild.mjs site .github/scripts",
    "build": "node esbuild.mjs",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --test .test-build/test/unit/*.test.js",
    "test:integration": "npm run test:compile && node --test --test-concurrency=2 .test-build/test/integration/*.test.js",
    "test:extension": "npm run build && npm run test:compile && node scripts/test-extension.cjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --release",
    "test:stress": "npm run test:compile && node --test .test-build/test/stress/*.test.js",
    "package": "node scripts/package-private.cjs && node scripts/verify-package.cjs",
    "package:public-candidate": "npm run check && node scripts/package-public-candidate.cjs",
    "audit:licenses": "node scripts/audit-licenses.cjs",
    "site:build": "node scripts/build-site.cjs",
    "site:serve": "node scripts/serve-site.cjs",
    "site:og": "node scripts/render-og.cjs",
    "site:deploy": "node scripts/deploy-site.cjs"
  },
